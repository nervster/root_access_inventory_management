# One site's settings. Copy to deploy/.env.staging or deploy/.env.production (git-ignored) on the Mac and
# fill in; deploy.sh copies it to that site's VM. Staging uses the dev Shopify store and Clerk's test
# instance; only production may ever connect the real store.

# stock-staging.rootaccesshtx.com or stock.rootaccesshtx.com
DOMAIN=

# Make one with: openssl rand -hex 24 (hex, so it's safe inside the database URL).
# Set it before the first deploy: Postgres only reads it when it creates the database.
POSTGRES_PASSWORD=

# Clerk (test keys work until the production Clerk instance is set up). The publishable key is built into
# the web image by deploy.sh.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
PLATFORM_ADMIN_EMAILS=

# Files (photos, later PDFs and reports): Google Cloud Storage, each site with its own bucket and HMAC key
# (both halves, from your password manager). Staging: plant-stock-rah-staging-files, service account
# staging-files. Production: plant-stock-rah-files, service account photos.
STORAGE_ENDPOINT=https://storage.googleapis.com
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Outgoing email, through Resend (rootaccesshtx.com is verified there). Port 587: Go's SMTP client
# switches to TLS on it, but can't do 465. Password: a Resend API key with sending access only, one per site.
SMTP_ADDR=smtp.resend.com:587
SMTP_USERNAME=resend
SMTP_PASSWORD=
EMAIL_FROM=Plant Stock <no-reply@rootaccesshtx.com>
# Who's emailed when the nightly database backup fails (deploy/backup-failed.sh).
ALERT_EMAIL=

# Shopify app. Leave the client ID out to turn Shopify off. SHOPIFY_TOKEN_KEY: openssl rand -base64 32
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_TOKEN_KEY=
