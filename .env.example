# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# Clerk Backend API secret (sk_test_…) → Clerk dashboard → API Keys. Read by the Go API and the backend container.
CLERK_SECRET_KEY=

# Clerk publishable key (pk_test_…, public) for building the web container (docker compose --profile app).
# `npm run dev` reads it from frontend/.env.development.local instead.
VITE_CLERK_PUBLISHABLE_KEY=

# Platform admins (comma-separated emails, the ones you sign in to Clerk with): may create and suspend nurseries.
PLATFORM_ADMIN_EMAILS=

# Photo storage: the local SeaweedFS stand-in (keep this line). Deployed: Google Cloud Storage, with
# S3_ENDPOINT=https://storage.googleapis.com, S3_REGION=auto, S3_BUCKET, and an HMAC key pair
# (S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY).
S3_ENDPOINT=http://localhost:8333

# Outgoing email. Leave unset locally (Mailpit catches everything); production sets a provider's SMTP relay.
# SMTP_ADDR=smtp.example.com:587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=Plant Stock <no-reply@example.com>

# Shopify app (Dev Dashboard → Plant Stock → Settings). Leave the client ID out to turn Shopify off.
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# Encrypts stores' tokens in the database. Make one with: openssl rand -base64 32
# (changing it later means every store must connect again)
# SHOPIFY_TOKEN_KEY=
