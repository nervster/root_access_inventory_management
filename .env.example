# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.

# Free LocalStack account → https://app.localstack.cloud → Auth Tokens
LOCALSTACK_AUTH_TOKEN=

# Clerk Backend API secret (sk_test_…) → Clerk dashboard → API Keys. Read by the Go API and the backend container.
CLERK_SECRET_KEY=

# Platform admins (comma-separated emails, the ones you sign in to Clerk with): may create and suspend nurseries.
PLATFORM_ADMIN_EMAILS=

# Outgoing email. Leave unset locally (Mailpit catches everything); production sets a provider's SMTP relay.
# SMTP_ADDR=smtp.example.com:587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=NMS <no-reply@example.com>
